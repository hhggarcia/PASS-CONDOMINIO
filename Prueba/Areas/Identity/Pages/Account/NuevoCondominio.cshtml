@page
@model Prueba.Areas.Identity.Pages.Account.NuevoCondominioModel
@{
    ViewData["Title"] = "Confirm email";
    Layout = "~/Areas/Identity/Pages/Account/Manage/_LayoutAccount.cshtml";

}

<style>
    /*Remover de aqui*/
    .form-control::placeholder {
        color: rgba(0, 0, 0, 0.5); /* Light color for placeholders */
        opacity: 1; /* Ensure the placeholder is fully visible */
    }
</style>

<div class="container-fluid mb-2">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-end justify-content-end mb-4">
        <a asp-action="Index" class="btn btn-light">Volver</a>
    </div>
    <!-- Content Row -->
    <div class="row justify-content-center">

        <div class="col-lg-4">
            <!-- User Card -->
            <div class="card shadow mb-4 bg-content-bg">
                <div class="card-header py-3">
                    <h4 class="m-0 font-weight-bold text-primary">
                        Crea tu Usuario
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row mb-3">
                            <!-- First form section: First Name -->
                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Input.ModeloNuevoCondominio.Owner.FirstName" class="form-control" placeholder="Your First Name" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Owner.FirstName" class="form-label">First Name</label>
                                </div>
                            </div>
                            <!-- Second form section: Last Name -->
                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Input.ModeloNuevoCondominio.Owner.LastName" class="form-control" placeholder="Your Last Name" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Owner.LastName" class="form-label">Last Name</label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <!-- First form section: User Name -->
                            <div class="col-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ModeloNuevoCondominio.Owner.UserName" class="form-control" placeholder="Your User Name" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Owner.UserName" class="form-label">User Name</label>
                                    <span asp-validation-for="Input.ModeloNuevoCondominio.Owner.UserName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <!-- First form section: Email -->
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ModeloNuevoCondominio.Owner.Email" class="form-control" placeholder="Your Email Address" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Owner.Email" class="form-label">Email</label>
                                <!-- El Error message no sale -->
                                    <span asp-validation-for="Input.ModeloNuevoCondominio.Owner.Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="form-control" placeholder="Your Password" />
                            <label asp-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="form-label">Password</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="text-danger"></span>
                        </div>
                        <!-- Confirm Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="form-control" placeholder="Your Password" />
                            <label asp-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="form-label">Confirm Password</label>
                                <!-- Chequear que sea la misma clave -->
                            <span asp-validation-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="text-danger"></span>
                        </div>
                        <!-- Terms and Conditions -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="termsCheck" required />
                            <label class="form-check-label" for="termsCheck">
                                Acepto los Terminos & Condiciones
                            </label>
                        </div>
                        <!-- Sign Up Button -->
                        <!-- Troubleshoot, el porque no se alinea el boton -->
                        <button type="submit" class="w-50 btn btn-lg btn-primary justify-content-center">Sign Up</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

    </script>
}