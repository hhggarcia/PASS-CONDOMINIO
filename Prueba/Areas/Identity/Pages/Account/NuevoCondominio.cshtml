@page
@model Prueba.Areas.Identity.Pages.Account.NuevoCondominioModel
@{
    ViewData["Title"] = "Confirm email";
    Layout = "~/Areas/Identity/Pages/Account/Manage/_LayoutCustom.cshtml";

}

<div class="container-fluid mb-2">
    @*<!-- Page Heading -->

    <div class="d-sm-flex align-items-end justify-content-end mb-4 hidden" id="VolverButton">
    <span type="submit" class="btn btn-light" onclick="volverCommand()">Volver</span>
    </div>*@
    <!-- Content Row -->
    <div class="row justify-content-center mb-2">
        <div class="col-lg-4" id="container-madre">
            <!-- User Card -->
            <div class="card shadow mb-4 bg-content-bg" id="UserSignupForm">
                <div class="card-header py-3">
                    <h4 class="m-0 font-weight-bold text-primary">
                        Crea tu Usuario
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row mb-3">
                            <!-- First Name -->
                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Input.ModeloNuevoCondominio.Owner.FirstName"
                                           class="form-control"
                                           placeholder="Nombre(s)"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Owner.FirstName"
                                           class="form-label"
                                           data-original="Nombre(s)"
                                           data-translated="Ingresa tu Nombre">Nombre(s)</label>
                                </div>
                            </div>
                            <!-- Last Name -->
                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Input.ModeloNuevoCondominio.Owner.LastName"
                                           class="form-control"
                                           placeholder="Apellido(s)"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Owner.LastName"
                                           class="form-label"
                                           data-original="Apellido(s)"
                                           data-translated="Ingresa tu Apellido">Apellido(s)</label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <!-- User Name -->
                            <div class="col-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ModeloNuevoCondominio.Owner.UserName"
                                           class="form-control"
                                           placeholder="Nombre de Usuario"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Owner.UserName"
                                           class="form-label"
                                           data-original="Nombre de Usuario"
                                           data-translated="Crea tu Usuario">Nombre de Usuario</label>
                                    <!-- Chequear si es valido -->
                                    <span asp-validation-for="Input.ModeloNuevoCondominio.Owner.UserName" class="text-danger"></span>
                                </div>
                            </div>
                            <!-- Email -->
                            <div class="col-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ModeloNuevoCondominio.Owner.Email"
                                           class="form-control"
                                           placeholder="Email"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Owner.Email"
                                           class="form-label"
                                           Email class="form-label"
                                           data-original="Email"
                                           data-translated="Ingresa tu Email">Email</label>
                                    <span asp-validation-for="Input.ModeloNuevoCondominio.Owner.Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.Owner.PasswordHash"
                                   class="form-control"
                                   placeholder="Contraseña"
                                   onfocus="toggleLabelText(this, true)"
                                   onblur="toggleLabelText(this, false)" />
                            <label asp-for="Input.ModeloNuevoCondominio.Owner.PasswordHash"
                                   class="form-label"
                                   Email class="form-label"
                                   data-original="Contraseña"
                                   data-translated="Ingresa tu Contraseña">Contraseña</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="text-danger"></span>
                        </div>
                        <!-- Confirm Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.Owner.PasswordHash"
                                   class="form-control"
                                   placeholder="Confirma tu Contraseña" />
                            <label asp-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="form-label">Confirma tu Contraseña</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.Owner.PasswordHash" class="text-danger"></span>
                        </div>
                        <!-- Terms and Conditions -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="termsCheck" required />
                            <label class="form-check-label" for="termsCheck">
                                Acepto los Terminos & Condiciones
                            </label>
                        </div>
                        <div class="row">
                            <!-- Cancel Button -->
                            <div class="col-6 d-flex justify-content-center align-items-center">
                                <a asp-action="Index" style="width: 80%;" class="btn btn-lg btn-secondary justify-content-center">Cancelar</a>
                            </div>
                            <!-- Continue Button -->
                            <div class="col-6 d-flex justify-content-center align-items-center">
                                <span type="submit" style="width: 80%;" class="btn btn-lg btn-primary justify-content-center" onclick="hideUserForm()">Continuar</span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <!-- Admin Card -->
            <div class="card shadow mb-4 bg-content-bg hidden" id="AdminSignupForm">
                <div class="card-header py-3">
                    <h4 class="m-0 font-weight-bold text-primary">
                        Registra tu Administrador
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row mb-3">
                            <!-- First Name -->
                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Input.ModeloNuevoCondominio.Administrator.FirstName"
                                           class="form-control"
                                           placeholder="Nombre(s)"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Administrator.FirstName"
                                           class="form-label"
                                           data-original="Nombre(s)"
                                           data-translated="Ingresa tu Nombre">Nombre(s)</label>
                                </div>
                            </div>
                            <!-- Last Name -->
                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Input.ModeloNuevoCondominio.Administrator.LastName"
                                           class="form-control"
                                           placeholder="Apellido(s)"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.Administrator.LastName"
                                           class="form-label"
                                           data-original="Apellido(s)"
                                           data-translated="Ingresa tu Apellido">Apellido(s)</label>
                                </div>
                            </div>
                        </div>
                        <!-- Email -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.Administrator.Email"
                                   class="form-control"
                                   placeholder="Email"
                                   onfocus="toggleLabelText(this, true)"
                                   onblur="toggleLabelText(this, false)" />
                            <label asp-for="Input.ModeloNuevoCondominio.Administrator.Email"
                                   class="form-label"
                                   Email class="form-label"
                                   data-original="Email"
                                   data-translated="Ingresa tu Email">Email</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.Administrator.Email" class="text-danger"></span>
                        </div>
                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.Administrator.PasswordHash"
                                   class="form-control"
                                   placeholder="Contraseña"
                                   onfocus="toggleLabelText(this, true)"
                                   onblur="toggleLabelText(this, false)" />
                            <label asp-for="Input.ModeloNuevoCondominio.Administrator.PasswordHash"
                                   class="form-label"
                                   Email class="form-label"
                                   data-original="Contraseña"
                                   data-translated="Ingresa tu Contraseña">Contraseña</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.Administrator.PasswordHash" class="text-danger"></span>
                        </div>
                        <!-- Confirm Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.Administrator.PasswordHash"
                                   class="form-control"
                                   placeholder="Confirma tu Contraseña" />
                            <label asp-for="Input.ModeloNuevoCondominio.Administrator.PasswordHash" class="form-label">Confirma tu Contraseña</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.Administrator.PasswordHash" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <!-- Back Button -->
                            <div class="col-6 d-flex justify-content-center align-items-center">
                                <span type="submit" style="width: 80%;" class="btn btn-lg btn-secondary justify-content-center" onclick="volverCommand()">Volver</span>
                            </div>
                            <!-- Continue Button -->
                            <div class="col-6 d-flex justify-content-center align-items-center">
                                <span type="submit" style="width: 80%;" class="btn btn-lg btn-primary justify-content-center" onclick="hideAdminForm()">Continuar</span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <!-- Condominio Card -->
            <div class="card shadow mb-4 bg-content-bg hidden" id="CondominioForm">
                <div class="card-header py-3">
                    <h4 class="m-0 font-weight-bold text-primary">
                        Registra tu Condominio
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <!-- Contribuyente Especial -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="SpecialCheck" />
                            <label class="form-check-label" for="SpecialCheck">
                                Contribuyente Especial
                            </label>
                        </div>
                        <div class="row mb-3">
                            <!-- Rif -->
                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Rif"
                                           class="form-control"
                                           placeholder="Rif"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Rif"
                                           class="form-label"
                                           Email class="form-label"
                                           data-original="Rif"
                                           data-translated="Ingresa tu Rif">Rif</label>
                                </div>
                            </div>
                            <!-- Tipo -->
                            <div class="col-6">
                                <div class="form-floating">
                                    <select asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Tipo" class="form-select">
                                        <option value="">Tipo de Condominio</option>
                                        <option value="Option 1">Residencial</option>
                                        <option value="Option 2">Empresarial</option>
                                        <option value="Option 3">Locales</option>
                                    </select>

                                    <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Tipo" class="form-label">Seleccione un Tipo</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <!-- Nombre del Condominio -->
                                <div class="form-floating mb-3 position-relative">
                                    <input asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Nombre"
                                           class="form-control"
                                           placeholder="Condominio"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Nombre"
                                           class="form-label"
                                           Email class="form-label"
                                           data-original="Condominio"
                                           data-translated="Nombre del Condominio">Condominio</label>
                                </div>
                            </div>
                            <!-- Dirección -->
                            <div class="col-6">
                                <div class="form-floating mb-3 position-relative">
                                    <input asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Direccion"
                                           class="form-control"
                                           placeholder="Dirección"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.InteresMora"
                                           class="form-label"
                                           Email class="form-label"
                                           data-original="Dirección"
                                           data-translated="Ingresa la Dirección">Dirección</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <!-- InteresMora -->
                                <!-- Cambiar si es en $ o Bs. -->
                                <div class="form-floating mb-3 position-relative">
                                    <input asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.InteresMora"
                                           class="form-control pe-5"
                                           type="number"
                                           placeholder="Interés/Mora"
                                           oninput="adjustCurrencyPosition(this)"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.InteresMora"
                                           class="form-label"
                                           Email class="form-label"
                                           data-original="Interés/Mora"
                                           data-translated="¿Cuanto se Cobrará de Mora?">Interés/Mora</label>
                                    <!-- Currency symbol displayed to the right of the input -->
                                    <span class="currency-symbol">Bs.</span>
                                </div>
                            </div>
                            <!-- Multa -->
                            <!-- Cambiar si es en $ o Bs. -->
                            <!-- Cambiar si es % -->
                            <div class="col-6">
                                <div class="form-floating mb-3 position-relative">
                                    <input asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Multa"
                                           class="form-control pe-5"
                                           type="number"
                                           placeholder="Multa"
                                           oninput="adjustCurrencyPosition(this)"
                                           onfocus="toggleLabelText(this, true)"
                                           onblur="toggleLabelText(this, false)" />
                                    <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Multa"
                                           class="form-label"
                                           Email class="form-label"
                                           data-original="Multa"
                                           data-translated="¿Cuanto se Cobrará de Multa?">Multa</label>
                                    <!-- Currency symbol displayed to the right of the input -->
                                    <span class="currency-symbol">Bs.</span>
                                </div>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Email"
                                   class="form-control"
                                   placeholder="Email"
                                   onfocus="toggleLabelText(this, true)"
                                   onblur="toggleLabelText(this, false)" />
                            <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.Email"
                                   class="form-label"
                                   Email class="form-label"
                                   data-original="Email"
                                   data-translated="Ingresa tu Email">Email</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.CondminioNuevo.Email" class="text-danger"></span>
                        </div>
                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.ClaveCorreo"
                                   class="form-control"
                                   placeholder="Contraseña"
                                   onfocus="toggleLabelText(this, true)"
                                   onblur="toggleLabelText(this, false)" />
                            <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.ClaveCorreo"
                                   class="form-label"
                                   Email class="form-label"
                                   data-original="Contraseña"
                                   data-translated="Ingresa tu Contraseña">Contraseña</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.CondminioNuevo.ClaveCorreo" class="text-danger"></span>
                        </div>
                        <!-- Confirm Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.ClaveCorreo"
                                   class="form-control"
                                   placeholder="Confirma tu Contraseña" />
                            <label asp-for="Input.ModeloNuevoCondominio.CondminioNuevo.ClaveCorreo" class="form-label">Confirma tu Contraseña</label>
                            <span asp-validation-for="Input.ModeloNuevoCondominio.CondminioNuevo.ClaveCorreo" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <!-- Back Button -->
                            <div class="col-6 d-flex justify-content-center align-items-center">
                                <span type="submit" class="w-100 btn btn-lg btn-secondary justify-content-center" onclick="volverCommand()">Volver</span>
                            </div>
                            <!-- Continue Button -->
                            <div class="col-6 d-flex justify-content-center align-items-center">
                                <span type="submit" class="w-100 btn btn-lg btn-primary justify-content-center" onclick="hideCondominioForm()">Continuar</span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <!-- Subscription Page -->
            <div class="card shadow mb-4 bg-content-bg hidden" id="SubscriptionForm">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h4 class="m-0 font-weight-bold text-primary">
                        Planes de Suscripción
                    </h4>
                    <div id="VolverButton" class="d-none d-sm-block w-50" style="max-width: 100px;">
                        <span type="submit" class="btn btn-lg btn-secondary w-100 justify-content-center" onclick="volverCommand()">Volver</span>
                    </div>
                </div>

                <div class="card-body row">
                    <div class="col-md-4 d-flex">
                        <div class="card flex-grow-1 d-flex flex-column">
                            <div class="subs-header">
                                <h5 class="mb-0">
                                    Gratis
                                </h5>
                            </div>
                            <div class="card-body d-flex flex-column flex-grow-1">
                                <h6 class="card-title">$0/mes</h6>
                                <p class="card-text">Cosas Basicas</p>
                                <ul>
                                    <li>Item 1</li>
                                    <li>Item 2</li>
                                    <li>Item 3</li>
                                </ul>
                                <a href="#" class="btn btn-primary mt-auto w-80 justify-content-center">Continuar Gratis</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex">
                        <div class="card flex-grow-1 d-flex flex-column">
                            <div class="subs-header">
                                <h5 class="mb-0">
                                    Standard
                                </h5>
                            </div>
                            <div class="card-body d-flex flex-column flex-grow-1">
                                <h6 class="card-title">$10/mes</h6>
                                <p class="card-text">Cosas Avanzadas.</p>
                                <ul>
                                    <li>Item 1</li>
                                    <li>Item 2</li>
                                    <li>Item 3</li>
                                    <li>Item 4</li>
                                </ul>
                                <a href="#" class="btn btn-primary mt-auto w-80 justify-content-center">Quiero Standard</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex">
                        <div class="card flex-grow-1 d-flex flex-column">
                            <div class="subs-header">
                                <h5 class="mb-0">
                                    Premium
                                </h5>
                            </div>
                            <div class="card-body d-flex flex-column flex-grow-1">
                                <h6 class="card-title">$20/mes</h6>
                                <p class="card-text">Cosas Premium</p>
                                <ul>
                                    <li>Item 1</li>
                                    <li>Item 2</li>
                                    <li>Item 3</li>
                                    <li>Item 4</li>
                                    <li>Item 5</li>
                                </ul>
                                <a href="#" class="btn btn-primary mt-auto w-80 justify-content-center">Dame Premium</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        function adjustCurrencyPosition(input) {
            const symbol = input.closest('.form-floating').querySelector('.currency-symbol');
            if (input.value.trim() !== "") {
                symbol.classList.add('adjusted');
            } else {
                symbol.classList.remove('adjusted');
            }
        }

        function toggleLabelText(input, isFocus) {
            const label = input.closest('.form-floating').querySelector('.form-label');
            if (label) {
                label.textContent = isFocus ? label.getAttribute('data-translated') : label.getAttribute('data-original');
            }
        }

        function hideUserForm() {
            const userForm = document.getElementById("UserSignupForm");
            const adminForm = document.getElementById("AdminSignupForm");

            userForm.classList.add("hidden");
            adminForm.classList.remove("hidden");
        }

        function hideAdminForm() {
            const adminForm = document.getElementById("AdminSignupForm");
            const condominioForm = document.getElementById("CondominioForm");

            adminForm.classList.add("hidden");

            document.getElementById("container-madre").classList.remove("col-lg-4");
            document.getElementById("container-madre").classList.add("col-lg-6");

            condominioForm.classList.remove("hidden");
        }

        function hideCondominioForm() {
            const condominioForm = document.getElementById("CondominioForm");
            const subsForm = document.getElementById("SubscriptionForm");
            const volverBtn = document.getElementById("VolverButton");

            condominioForm.classList.add("hidden");
            subsForm.classList.remove("hidden");
            volverBtn.classList.remove("hidden");
        }

        function volverCommand() {
            const userForm = document.getElementById("UserSignupForm");
            const adminForm = document.getElementById("AdminSignupForm");
            const condominioForm = document.getElementById("CondominioForm");
            const subsForm = document.getElementById("SubscriptionForm");
            const volverBtn = document.getElementById("VolverButton");

            if (!adminForm.classList.contains("hidden")) {
                // If we are on the Admin form, go back to User form
                adminForm.classList.add("hidden");
                userForm.classList.remove("hidden");
            } else if (!condominioForm.classList.contains("hidden")) {
                // If we are on the Condominio form, go back to Admin form
                condominioForm.classList.add("hidden");
                adminForm.classList.remove("hidden");
            } else if (!subsForm.classList.contains("hidden")) {
                // If we are on the Condominio form, go back to Admin form
                subsForm.classList.add("hidden");
                volverBtn.classList.add("hidden");
                condominioForm.classList.remove("hidden");
            }
        }
    </script>
}