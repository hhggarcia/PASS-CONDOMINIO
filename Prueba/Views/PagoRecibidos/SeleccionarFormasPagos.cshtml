@{
    ViewData["Title"] = "Seleccionar Formas de Pago";
    Layout = "~/Views/Shared/_LayoutPropietario.cshtml";
}

<style>
    .credit-card {
        width: 100%;
        max-width: 350px;
        height: auto;
        background: linear-gradient(135deg, #1e5799 0%, #2989d8 50%, #207cca 100%);
        color: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        margin: 0 auto;
    }

    .card-logo img {
        width: 50px;
        height: auto;
    }

    .card-title {
        margin-top: 20px;
        font-size: 1.2em;
    }

    .card-text {
        font-size: 1em;
    }

    @@media (max-width: 576px) {
        .credit-card

    {
        padding: 15px;
    }

    .card-title {
        font-size: 1em;
    }

    .card-text {
        font-size: 0.9em;
    }

    }
</style>

<div class="row">
    <div class="container mt-5">
        <div class="card credit-card mx-auto">
            <div class="card-body">
                <div class="card-logo">
                    <img src="logo.png" alt="Logo" class="img-fluid" />
                </div>
                <h5 class="card-title">Nombre del Titular</h5>
                <p class="card-text">1234 5678 9012 3456</p>
                <p class="card-text">Expira: 12/25</p>
            </div>
        </div>
    </div>    
</div>
