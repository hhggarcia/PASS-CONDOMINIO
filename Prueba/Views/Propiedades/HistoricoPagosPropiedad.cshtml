@model IEnumerable<Prueba.ViewModels.HistoricoPropiedadPagosVM>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}

<style>
    .collapse {
        transition: height 0.2s ease !important; /* Ajusta la duración de la animación aquí */
    }
</style>

<div class="container-fluid">
    <!-- Page Heading -->
    @* <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <a class="btn btn-light mb-3" asp-controller="Propiedades"
           asp-action="CreatePropiedad">
            Registrar
        </a>
    </div> *@

    @if (Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="row">
                <div class="col-lg-12 mb-4">
                    <!-- DataTales Example -->
                    <div class="card shadow mb-4 bg-content-bg">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">
                                @item.Propiedad.Codigo
                            </h6>
                            <button class="btn btn-link" data-toggle="collapse" data-target="#properties-@item.Propiedad.Codigo">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </div>
                        <div id="properties-@item.Propiedad.Codigo" class="collapse">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table text-center"
                                           id="dataTable"
                                           width="100%"
                                           cellspacing="0">
                                        <thead>
                                            <tr>
                                                <th>
                                                    Fecha
                                                </th>
                                                <th>
                                                    Monto
                                                </th>
                                                <th>
                                                    Forma de Pago
                                                </th>
                                                <th>
                                                    Referencia
                                                </th>
                                                <th>
                                                    Saldo Total
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (item.Pagos.Any())
                                            {
                                                @foreach (var pago in item.Pagos)
                                                {
                                                    <tr>
                                                        <td>
                                                            @pago.IdPagoNavigation.Fecha.ToString("dd/MM/yyyy")
                                                        </td>
                                                        <td>
                                                            @pago.IdPagoNavigation.Monto.ToString("N")
                                                        </td>
                                                        <td>
                                                            @(pago.IdPagoNavigation.FormaPago ? "Transferencia" : "Efectivo")
                                                        </td>
                                                        <td>
                                                            @if (pago.IdPagoNavigation.ReferenciasPrs.Any())
                                                            {
                                                                @pago.IdPagoNavigation.ReferenciasPrs.First().NumReferencia
                                                            }
                                                        </td>
                                                        <td>
                                                            0
                                                        </td>
                                                    </tr>
                                                }
                                            }                                            
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    }
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
}